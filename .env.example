# Web
NEXT_PUBLIC_VISION_WASM_PATH=/vision
NEXT_PUBLIC_FACE_MODEL_PATH=/models/face_landmarker.task
NEXT_PUBLIC_API_URL=http://localhost:4000

# API / local PostgreSQL
DATABASE_URL=postgresql://eyewear:eyewear@localhost:5432/eyewear?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=replace-with-a-12-character-local-password
SEED_SECOND_OWNER_EMAIL=second-owner@example.test
SEED_SECOND_OWNER_PASSWORD=replace-with-a-12-character-local-password
STORAGE_LOCAL_DIR=./.data/objects

# Object storage: local (default) or s3
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
REDIS_URL=

# Docker Compose seed profile
# Run: docker compose --profile seed run --rm seed
