# Copy to .env for Docker Compose; generate unique random secrets before use.
DATABASE_URL=postgresql://eyewear:eyewear@localhost:5432/eyewear?schema=public
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
NEXTAUTH_SECRET=replace-with-a-separate-unique-random-session-secret
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=4000

# Local demo seed only. Admin email: admin@eye-club.local
SEED_OWNER_PASSWORD=replace-with-at-least-12-characters

# Copy web values to client/.env.local when running without Docker.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VISION_WASM_PATH=/vision
NEXT_PUBLIC_FACE_MODEL_PATH=/models/face_landmarker.task
NEXT_PUBLIC_DEMO_MODE=false
# Comma-separated merchant origins, no paths or trailing slashes.
WIDGET_EMBED_ORIGINS=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/objects
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
REDIS_URL=

# Production password reset/verification delivery: authenticated HTTPS webhook.
ACCOUNT_EMAIL_WEBHOOK=
ACCOUNT_EMAIL_WEBHOOK_SECRET=
