{
  "name": "virtual-eyewear",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@eyewear/web",
    "build": "npm run build --workspace=@eyewear/web",
    "start": "npm run start --workspace=@eyewear/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p packages/tryon-engine/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit && tsc -p packages/widget/tsconfig.json --noEmit",
    "test": "vitest run",
    "assets:setup": "node scripts/setup-vision.mjs",
    "build:widget": "npm run build --workspace=@eyewear/widget",
    "test:e2e": "playwright test",
    "dev:api": "node scripts/dev-microservices.mjs",
    "dev:microservices": "node scripts/dev-microservices.mjs",
    "build:api": "npm run build --workspace=@eyewear/api",
    "start:api": "npm run start --workspace=@eyewear/api",
    "start:gateway": "MICROSERVICE_ROLE=api-gateway PORT=4000 npm run start --workspace=@eyewear/api",
    "start:identity": "MICROSERVICE_ROLE=identity-tenant-service PORT=4001 npm run start --workspace=@eyewear/api",
    "start:catalog": "MICROSERVICE_ROLE=catalog-tryon-service PORT=4002 npm run start --workspace=@eyewear/api",
    "start:commerce": "MICROSERVICE_ROLE=commerce-order-service PORT=4003 npm run start --workspace=@eyewear/api",
    "start:clinical": "MICROSERVICE_ROLE=clinical-store-service PORT=4004 npm run start --workspace=@eyewear/api",
    "start:pos": "MICROSERVICE_ROLE=pos-lab-service PORT=4005 npm run start --workspace=@eyewear/api",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:validate": "prisma validate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "npm run prisma:seed --workspace=@eyewear/api",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "@playwright/test": "latest",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "sharp": "0.35.4"
  },
  "type": "module"
}
