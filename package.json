{
  "name": "virtual-eyewear",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@eyewear/web",
    "build": "npm run build --workspace=@eyewear/web",
    "start": "npm run start --workspace=@eyewear/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p packages/tryon-engine/tsconfig.json --noEmit && tsc -p packages/ui/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/widget/tsconfig.json --noEmit",
    "test": "vitest run",
    "assets:setup": "node scripts/setup-vision.mjs",
    "build:widget": "npm run build --workspace=@eyewear/widget"
    ,"test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "eslint": "9.39.5",
    "@playwright/test": "latest",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "sharp": "0.35.4"
  },
  "type": "module"
}
